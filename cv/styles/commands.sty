% Create on-going education entry
%   1 - [optional] specialization
%   2 - name of education
%   3 - university
\newcommand{\educationOngoing}[3][]{
  \unskip\noindent
  \makebox[0pt][l]{%
    \hspace{0pt}%
    \makebox[8cm][l]{%
      \textbf{\large \textcolor{text}{#2}}%
      \if\relax\detokenize{#1}\relax\else
        \textcolor{annotation}{\small\space\textperiodcentered\space #1}%
      \fi
      \textcolor{annotation}{\small\space\textperiodcentered\space Ongoing}%
    }%
  }%
  \hspace*{8cm}%
  \textcolor{annotation}{\faUniversity\space #3}
}

