\ProvidesPackage{styles/colors}

% The website's palette (src/styles/global.css, the source of truth): the
% cool greys of Chrome on iOS, never pure black or white. Colors the website
% lacks (sidebar, section bands) carry the same blue cast. \cvtheme (main.tex)
% picks one: `light` (default) or `dark`, the latter built by
% `npm run build:cv` as szymon-maszke-cv-dark.pdf.

\def\cvthemedark{dark}
\ifx\cvtheme\cvthemedark

  % ------------------------------------------------------------------ dark

  % Bar and background (the bars sit above the page, like raised surfaces)
  \definecolor{topbar}{HTML}{3c4043}
  \definecolor{sidebar}{HTML}{404447}
  \definecolor{background}{HTML}{353739}

  % Text colors
  \definecolor{text}{HTML}{e8eaed}
  \definecolor{annotation}{HTML}{bdc1c6}
  \definecolor{clause}{HTML}{80868b}
  \definecolor{linkline}{HTML}{5f6368}

  % Top bar icon tiles (inverted: light tile, dark glyph)
  \definecolor{gmail}{HTML}{bdc1c6}
  \definecolor{github}{HTML}{bdc1c6}
  \definecolor{website}{HTML}{bdc1c6}
  \definecolor{stackoverflow}{HTML}{bdc1c6}

  % Section colors (lightest at the top, closer to the sidebar going down)
  \definecolor{postgraduate}{HTML}{5a5e63}
  \definecolor{summary}{HTML}{55595d}
  \definecolor{fractional}{HTML}{505458}
  \definecolor{research}{HTML}{4c5054}
  \definecolor{skills}{HTML}{484c50}
  \definecolor{languages}{HTML}{44484b}
  \definecolor{certificates}{HTML}{55595d}

  \definecolor{education}{HTML}{5a5e63}
  \definecolor{work}{HTML}{55595d}

  % Tags color (faint fill of the text color)
  \definecolor{skilltag}{HTML}{e8eaed}
  \definecolor{langtag}{HTML}{e8eaed}

\else

  % ----------------------------------------------------------------- light

  % Bar and background
  \definecolor{topbar}{HTML}{e2e4e7}
  \definecolor{sidebar}{HTML}{dadce0}
  \definecolor{background}{HTML}{f1f3f4}

  % Text colors
  \definecolor{text}{HTML}{4d5156}
  \definecolor{annotation}{HTML}{5f6368}
  \definecolor{clause}{HTML}{9aa0a6}
  \definecolor{linkline}{HTML}{9aa0a6}

  % Top bar icon tiles (inverted: charcoal tile, light glyph)
  \definecolor{gmail}{HTML}{5f6368}
  \definecolor{github}{HTML}{5f6368}
  \definecolor{website}{HTML}{5f6368}
  \definecolor{stackoverflow}{HTML}{5f6368}

  % Section colors (darkest at the top, lighter going down)
  \definecolor{postgraduate}{HTML}{a0a6ac}
  \definecolor{summary}{HTML}{abb0b6}
  \definecolor{fractional}{HTML}{b6babf}
  \definecolor{research}{HTML}{bec2c7}
  \definecolor{skills}{HTML}{c5c8cd}
  \definecolor{languages}{HTML}{cccfd3}
  \definecolor{certificates}{HTML}{abb0b6}

  \definecolor{education}{HTML}{a0a6ac}
  \definecolor{work}{HTML}{abb0b6}

  % Tags color (faint fill of the text color)
  \definecolor{skilltag}{HTML}{4d5156}
  \definecolor{langtag}{HTML}{4d5156}

\fi
