---
// SPDX-FileCopyrightText: © 2026 Szymon Maszke <https://github.com/szymonmaszke>
// SPDX-License-Identifier: Apache-2.0

// Section switcher: a sticky bar of links to the sections of the page
// (each a [data-panel] element with the same id). Without JavaScript it is an
// in-page menu over a long page; src/scripts/tabs.ts turns it into tabs (one
// section at a time, the filled block slides to the chosen one, #hash synced).
import { site } from "../site.config";
import Arrow from "./Arrow.astro";
import Icon from "./Icon.astro";

interface Props {
  /** The sections, in tab order. */
  sections: {
    /** Id of the section's [data-panel] element, also its anchor (`/#experience`). */
    id: string;
    /** Label shown on the tab. */
    tab: string;
  }[];
}

const { sections } = Astro.props;
---

<div class="tabs">
  <div class="wrap">
    <nav class="tablist" aria-label={site.ui.sections} data-tablist>
      <span class="block" aria-hidden="true"></span>
      {sections.map((section) => (
        <a href={`#${section.id}`} id={`tab-${section.id}`} data-tab={section.id}>
          <Arrow direction="down" size={16} class="cue" />
          <span class="label" data-text={section.tab}>
            {section.tab}
          </span>
        </a>
      ))}
    </nav>
    {/* the carousel's ends (phones, tabs.ts): open the previous / next section */}
    <button type="button" class="step prev" data-step="-1" aria-label={site.ui.previous} hidden>
      <Icon name="chevron" size={16} />
    </button>
    <button type="button" class="step next" data-step="1" aria-label={site.ui.next} hidden>
      <Icon name="chevron" size={16} />
    </button>
  </div>
</div>

<script>
import "../scripts/tabs";
</script>

<style>
.tabs {
  position: sticky;
  top: var(--header);
  z-index: 5;
  /* padding, not the capsule's margin: a margin would collapse through to
     the outside of the bar and leave the capsule touching the content that
     scrolls under it. More room below: the content scrolls under there. */
  padding-block: 0.5rem 1rem;
  background: var(--bg);
  box-shadow: inset 0 -1px transparent;
  transition: box-shadow var(--slow) var(--ease);
}

/* phones: the hairline fades in once the page scrolls (Header.astro);
   desktop has the line under the bar instead (index.astro .panels-rule) */
@media (max-width: 48rem) {
  :global(:root[data-scrolled]) .tabs {
    box-shadow: inset 0 -1px var(--line);
  }
}

/* A capsule switch, as on opennudge.com: a track raised like the hero's
   boxes above it (the same surface, ring and shadow), the chosen segment a
   filled --inverse block (the other mode's box) that slides between
   segments.
   Without scripts, narrow screens scroll it sideways, never the page. */
.tablist {
  position: relative;
  display: flex;
  width: max-content;
  max-width: 100%;
  padding: 3px;
  gap: 2px;
  border-radius: var(--pill);
  background: var(--surface);
  box-shadow: var(--raised);
  overflow-x: auto;
  overscroll-behavior-x: contain;
  scroll-snap-type: x proximity;
  scroll-padding-inline: 3px;
  scrollbar-width: none;
}

.tablist::-webkit-scrollbar {
  display: none;
}

.tablist a {
  position: relative; /* above the sliding thumb */
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  flex: none;
  padding: 0.3rem 0.875rem;
  border-radius: var(--pill);
  color: var(--muted);
  font-size: 0.875rem;
  font-weight: 400;
  line-height: 1.3;
  text-decoration: none;
  white-space: nowrap;
  scroll-snap-align: start;
}

/* each label reserves the width of its bold version (the invisible
   ::after), so choosing a tab never shifts the others */
.label {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
}

.label::after {
  content: attr(data-text) / "";
  height: 0;
  overflow: hidden;
  visibility: hidden;
  font-weight: 700;
  user-select: none;
  pointer-events: none;
}

/* The open tab's arrow points down to its section, bobbing. Every tab
   keeps the arrow's room (choosing one shifts none of the others, and the
   carousel stays centered); only the open one shows it. */
.tablist a :global(.cue) {
  opacity: 0;
  transition: opacity var(--slow) var(--ease);
}

.tablist a[data-current] :global(.cue) {
  opacity: 1;
}

.tablist a[data-current] :global(.cue path) {
  animation: bounce 2s ease-in-out infinite;
}

.tablist a:hover {
  color: var(--text);
}

.tablist a[aria-selected="true"] {
  color: var(--on-inverse);
  font-weight: 700;
}

.tablist a:focus-visible {
  outline-offset: -2px;
}

.block {
  position: absolute;
  top: 3px;
  bottom: 3px;
  left: 0;
  width: var(--w, 0);
  border-radius: var(--pill);
  background: var(--inverse);
  transform: translateX(var(--x, 0));
  opacity: 0;
}

/* tabs only once the script has measured the chosen tab */
.tablist[data-ready] .block {
  opacity: 1;
}

.tablist[data-animate] .block {
  transition:
    transform var(--slow) var(--ease),
    width var(--slow) var(--ease);
}

/* The endless carousel (carousel.ts, when the tabs don't fit): the track spans
   the screen, edge to edge, and fades out at both ends under the arrows; the
   tab set repeats past them, and the chosen tab (each copy of it) is filled
   in place of the sliding block. */
.tabs .wrap {
  position: relative;
}

/* the track (its surface) runs under the arrows, edge to edge; only the
   tabs fade */
.tabs:has(.tablist[data-carousel]) .wrap {
  padding-inline: 0;
  background: var(--surface);
  box-shadow: var(--raised);
}

/* The tabs fade out before the arrows: clear under each arrow (--clear,
   the arrow and a little room), then in over --ramp along a smoothstep
   curve, so neither end of the fade shows a band. */
.tablist[data-carousel] {
  width: 100%;
  border-radius: 0;
  background: none;
  box-shadow: none;
  --clear: 2.75rem;
  --ramp: 3rem;
  --edges: linear-gradient(
    to right,
    transparent calc(var(--clear) + 0 * var(--ramp)),
    rgb(0 0 0 / 0.043) calc(var(--clear) + 0.125 * var(--ramp)),
    rgb(0 0 0 / 0.156) calc(var(--clear) + 0.25 * var(--ramp)),
    rgb(0 0 0 / 0.316) calc(var(--clear) + 0.375 * var(--ramp)),
    rgb(0 0 0 / 0.5) calc(var(--clear) + 0.5 * var(--ramp)),
    rgb(0 0 0 / 0.684) calc(var(--clear) + 0.625 * var(--ramp)),
    rgb(0 0 0 / 0.844) calc(var(--clear) + 0.75 * var(--ramp)),
    rgb(0 0 0 / 0.957) calc(var(--clear) + 0.875 * var(--ramp)),
    #000 calc(var(--clear) + 1 * var(--ramp)),
    #000 calc(100% - var(--clear) - 1 * var(--ramp)),
    rgb(0 0 0 / 0.957) calc(100% - var(--clear) - 0.875 * var(--ramp)),
    rgb(0 0 0 / 0.844) calc(100% - var(--clear) - 0.75 * var(--ramp)),
    rgb(0 0 0 / 0.684) calc(100% - var(--clear) - 0.625 * var(--ramp)),
    rgb(0 0 0 / 0.5) calc(100% - var(--clear) - 0.5 * var(--ramp)),
    rgb(0 0 0 / 0.316) calc(100% - var(--clear) - 0.375 * var(--ramp)),
    rgb(0 0 0 / 0.156) calc(100% - var(--clear) - 0.25 * var(--ramp)),
    rgb(0 0 0 / 0.043) calc(100% - var(--clear) - 0.125 * var(--ramp)),
    transparent calc(100% - var(--clear) - 0 * var(--ramp))
  );
  -webkit-mask-image: var(--edges);
  mask-image: var(--edges);
}

.tablist[data-carousel] .block {
  display: none;
}

.tablist[data-carousel] a {
  scroll-snap-align: center;
}

.tablist[data-carousel] a[data-current] {
  background: var(--inverse);
  color: var(--on-inverse);
  font-weight: 700;
}

/* round buttons over the faded ends, lifted off the track */
.step {
  position: absolute;
  top: 50%;
  display: grid;
  place-items: center;
  width: 2.25rem;
  height: 2.25rem;
  padding: 0;
  border: 0;
  border-radius: var(--pill);
  background: var(--surface);
  color: var(--text);
  box-shadow:
    0 1px 2px var(--shadow),
    0 4px 10px -4px var(--shadow);
  cursor: pointer;
  translate: 0 -50%;
}

.step.prev {
  left: max(0.375rem, env(safe-area-inset-left, 0px));
}

.step.next {
  right: max(0.375rem, env(safe-area-inset-right, 0px));
}

.step.prev :global(svg) {
  transform: scaleX(-1);
}

.step:active {
  background: var(--surface-hover);
}

.step:focus-visible {
  outline-offset: 2px;
}

@media (pointer: coarse) {
  .tablist a {
    padding-block: 0.5rem;
  }

  /* thumbs need 44px targets */
  .step::before {
    content: "";
    position: absolute;
    inset: -0.25rem;
  }
}

/* desktop: the bar spans the content (as wide as the hero's boxes) and the
   capsule is as tall as the hero's buttons (global.css .button: 1.2rem of
   text, 0.6rem padding and a 1px border; less the capsule's 3px inset),
   whatever the tabs' text size. Each tab is as wide as its own text, and
   the room left over is shared equally, so the labels sit evenly apart and
   as far from both ends of the capsule; the filled block covers its tab,
   out to the capsule's 3px inset at either end. A carousel keeps its tabs
   their own width. */
@media (min-width: 48.0625rem) {
  /* ADJUST HERE: the tabs' text size (smaller: the capsule fits on
     narrower screens before it turns into a carousel) */
  .tablist {
    --tab-font: 0.9375rem;
    width: 100%;
  }

  .tablist a {
    justify-content: center;
    min-height: calc(2.4rem - 4px);
    padding: 0 0.625rem;
    font-size: var(--tab-font);
    line-height: 1.2;
  }

  .tablist:not([data-carousel]) a {
    flex: 1 1 auto;
  }

  /* Each label is centered in its tab: the arrow's room (--cue: the arrow
     and the gap after it) is taken half from each side. The open tab
     shows its arrow, and arrow and label together are centered in the
     block, so its label slides over by half the arrow (with the block). */
  .tablist:not([data-carousel]) {
    --cue: calc(16px + 0.3rem);
  }

  .tablist:not([data-carousel]) a > :global(*) {
    translate: calc(var(--cue) / -2) 0;
  }

  .tablist:not([data-carousel]) a[data-current] > :global(*) {
    translate: 0 0;
  }

  .tablist[data-animate]:not([data-carousel]) a > :global(*) {
    transition:
      translate var(--slow) var(--ease),
      opacity var(--slow) var(--ease);
  }
}

/* the buttons grow to 44px for thumbs (global.css), and so does the capsule */
@media (min-width: 48.0625rem) and (pointer: coarse) {
  .tablist a {
    min-height: calc(2.75rem - 6px);
    padding-block: 0;
  }
}
</style>
