---
// SPDX-FileCopyrightText: © 2026 Szymon Maszke <https://github.com/szymonmaszke>
// SPDX-License-Identifier: Apache-2.0

// Top bar: the name (once scrolled) · CV download · opennudge · StackOverflow ·
// GitHub · theme. Built like the opennudge.com header: the page color, a
// hairline once scrolled.
import OpennudgeMark from "../assets/brand/opennudge-mark.svg";
import { site } from "../site.config";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<!-- marks the top of the page: the bars get their hairline once this
     scrolls away (script below) -->
<div class="top-sentinel" aria-hidden="true"></div>
<header class="site-header">
  <div class="wrap bar">
    {/* the name, shown once the page's own title (the hero h1) has scrolled
        under the bar; hidden from screen readers, the h1 already says it */}
    <span class="name" aria-hidden="true">{site.name}</span>

    <div class="tools">
      <a href={site.cv.light} download class="cv" aria-label={site.ui.cvLabel}>
        <Icon name="download" size={16} />
        <span class="cv-label">{site.ui.cv}</span>
      </a>
      {/* biome-ignore lint/a11y/useAnchorContent: aria-label names the link, the mark is hidden */}
      <a
        href={site.links.opennudge}
        class="icon-button"
        aria-label={site.ui.opennudgeLabel}
        title={site.ui.opennudgeLabel}
      >
        <OpennudgeMark height={20} aria-hidden="true" class="mark" />
      </a>
      <a
        href={site.links.stackoverflow}
        class="icon-button"
        aria-label={site.ui.stackoverflowLabel}
        title={site.ui.stackoverflowLabel}
      >
        <Icon name="stackoverflow" size={18} />
      </a>
      <a href={site.links.github} class="icon-button" aria-label={site.ui.githubLabel}>
        <Icon name="github" size={18} />
      </a>
      <ThemeToggle />
      {/* phones: the links above fold into this menu (a native popover:
          tapping outside or Esc closes it) */}
      <button
        type="button"
        class="icon-button menu-button"
        popovertarget="site-menu"
        aria-label={site.ui.menu}
      >
        <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
          <path class="line" d="M2.5 5h13" />
          <path class="line" d="M2.5 9h13" />
          <path class="line" d="M2.5 13h13" />
        </svg>
      </button>
    </div>
  </div>
  {/* phones: a sheet over the top of the page, GitHub-style: its own bar
      (the name, the theme switch, a close button) above the links; the rest
      of the page dims (::backdrop), a tap there closes it */}
  <div id="site-menu" class="menu" popover>
    <div class="wrap menu-bar">
      <span class="name" aria-hidden="true">{site.name}</span>
      <div class="tools">
        <ThemeToggle />
        <button
          type="button"
          class="icon-button"
          popovertarget="site-menu"
          popovertargetaction="hide"
          aria-label={site.ui.closeMenu}
        >
          <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
            <path class="line" d="M4.5 4.5l9 9" />
            <path class="line" d="M13.5 4.5l-9 9" />
          </svg>
        </button>
      </div>
    </div>
    <nav class="wrap menu-links" aria-label={site.ui.menu}>
      <a href={site.cv.light} download>
        <Icon name="download" size={18} />
        {site.hero.actions.cv}
      </a>
      <a href={site.links.opennudge}>
        <OpennudgeMark height={18} aria-hidden="true" class="mark" />
        {site.ui.opennudgeLabel}
      </a>
      <a href={site.links.stackoverflow}>
        <Icon name="stackoverflow" size={18} />
        {site.ui.stackoverflow}
      </a>
      <a href={site.links.github}>
        <Icon name="github" size={18} />
        {site.ui.github}
      </a>
    </nav>
  </div>
</header>

<script>
// A tap on a menu link closes the menu (the CV download keeps the page).
const menu = document.querySelector<HTMLElement>("#site-menu");
menu?.addEventListener("click", (event) => {
  if (event.target instanceof Element && event.target.closest("a")) {
    menu.hidePopover();
  }
});

// At the top of the page the bars have no border, so they read as part of
// the browser's own toolbar (same color); once scrolled, a hairline fades in.
const sentinel = document.querySelector(".top-sentinel");
if (sentinel) {
  new IntersectionObserver(([entry]) => {
    document.documentElement.toggleAttribute("data-scrolled", !entry?.isIntersecting);
  }).observe(sentinel);
}

// The name appears in the bar once the page title ([data-page-title], the
// hero h1) is hidden under it: never two names on screen at once. Pages
// without one (404) show it from the start.
const title = document.querySelector("[data-page-title]");
const header = document.querySelector<HTMLElement>(".site-header");
if (!title) {
  document.documentElement.toggleAttribute("data-title-hidden", true);
} else if (header) {
  new IntersectionObserver(
    ([entry]) => {
      document.documentElement.toggleAttribute("data-title-hidden", !entry?.isIntersecting);
    },
    { rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
  ).observe(title);
}
</script>

<style>
.top-sentinel {
  position: absolute;
  top: 0;
  width: 1px;
  height: 1px;
  pointer-events: none;
}

/* The height is fixed (--header) so the section tabs can stick right under
   it. The hairline is drawn inside that height. */
.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  height: var(--header);
  padding-top: env(safe-area-inset-top, 0px);
  background: var(--bg);
  box-shadow: inset 0 -1px transparent;
  transition: box-shadow var(--slow) var(--ease);
}

:global(:root[data-scrolled]) .site-header {
  box-shadow: inset 0 -1px var(--line);
}

/* on a page with section tabs the bars read as one: the line goes under the
   tabs only */
:global(:root[data-scrolled] body:has(.tabs)) .site-header {
  box-shadow: inset 0 -1px transparent;
}

.bar {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  height: 100%;
}

/* the name: section heading type (h2: bold, tight), small; fades and rises
   in once the hero title is gone (script above). Until then it isn't there
   at all (visibility: not selectable, not draggable); visibility flips at
   the start of the fade-in and the end of the fade-out. */
.name {
  min-width: 0;
  overflow: hidden;
  /* near the h2 (up to 1.5rem); narrower on phones, where the tools need
     the room */
  font-size: var(--fs-title, clamp(1.125rem, 4.5vw, 1.3125rem));
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.01em;
  white-space: nowrap;
  text-overflow: ellipsis;
  visibility: hidden;
  opacity: 0;
  transform: translateY(0.25rem);
  transition:
    visibility var(--slow),
    opacity var(--slow) var(--ease),
    transform var(--slow) var(--ease);
}

:global(:root[data-title-hidden]) .name {
  visibility: visible;
  opacity: 1;
  transform: none;
}

.tools {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

/* the CV: a secondary capsule (raised like the boxes) */
.cv {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  height: 2.25rem;
  padding-inline: 0.875rem;
  margin-right: 0.25rem;
  border-radius: var(--pill);
  background: var(--surface);
  box-shadow: var(--raised);
  font-size: var(--fs-body, 0.9rem);
  font-weight: 700;
  text-decoration: none;
}

/* the opennudge mark, never recolored: it follows the text color. Its
   curves touch the edges of the viewBox: overflow keeps them whole. */
.mark {
  display: block;
  width: auto;
  overflow: visible;
}

@media (hover: hover) {
  .cv:hover {
    background: var(--surface-hover);
  }
}

.cv:active {
  background: var(--surface-hover);
}

/* thumbs need 44px targets */
@media (pointer: coarse) {
  .cv {
    height: 2.5rem;
  }
}

/* the menu button and its menu exist for phones only */
.menu-button {
  display: none;
}

.line {
  fill: none;
  stroke: currentColor;
  stroke-width: 1.5;
  stroke-linecap: round;
}

/* a sheet over the top of the page, as tall as its links; it slides down
   over the bar, which it repeats in place */
.menu {
  position: fixed;
  inset: 0 0 auto;
  width: auto;
  max-width: none;
  max-height: 100dvh;
  overflow: auto;
  overscroll-behavior: contain;
  margin: 0;
  padding: 0 0 0.5rem;
  border: 0;
  border-radius: 0 0 var(--radius) var(--radius);
  background: var(--surface);
  color: var(--text);
  box-shadow: 0 14px 28px -10px var(--shadow);
  opacity: 0;
  transform: translateY(-1rem);
  transition:
    opacity var(--slow) var(--ease),
    transform var(--slow) var(--ease),
    overlay var(--slow) allow-discrete,
    display var(--slow) allow-discrete;
}

.menu:popover-open {
  opacity: 1;
  transform: none;
}

@starting-style {
  .menu:popover-open {
    opacity: 0;
    transform: translateY(-1rem);
  }
}

/* the rest of the page dims; a tap there closes the menu */
.menu::backdrop {
  background: rgb(0 0 0 / 0);
  transition:
    background-color var(--slow) var(--ease),
    overlay var(--slow) allow-discrete,
    display var(--slow) allow-discrete;
}

.menu:popover-open::backdrop {
  background: rgb(0 0 0 / 0.5);
}

@starting-style {
  .menu:popover-open::backdrop {
    background: rgb(0 0 0 / 0);
  }
}

/* the page under the sheet stays put */
:global(:root:has(#site-menu:popover-open)) {
  overflow: hidden;
}

/* the sheet's bar: the header's, line for line (height, inset, gutters) */
.menu-bar {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  height: var(--header);
  padding-top: env(safe-area-inset-top, 0px);
  box-shadow: inset 0 -1px var(--line);
}

.menu-bar .tools {
  gap: 0;
}

/* in the sheet the name is always there */
.menu .name {
  visibility: visible;
  opacity: 1;
  transform: none;
}

/* two theme switches: only the one in sight takes part in the theme
   cross-fade (a shared view-transition-name would cancel it) */
:global(:root:has(#site-menu:popover-open)) .bar :global(.theme-toggle svg) {
  view-transition-name: none;
}

.menu-links {
  display: flex;
  flex-direction: column;
  padding-block: 0.5rem;
}

.menu-links a {
  display: flex;
  align-items: center;
  gap: 0.875rem;
  min-height: 3rem;
  /* the icons line up with the name above */
  margin-inline: -0.75rem;
  padding-inline: 0.75rem;
  border-radius: calc(var(--radius) - 0.375rem);
  font-size: var(--fs-body, 1.0625rem);
  font-weight: 700;
  text-decoration: none;
}

.menu-links a :global(svg) {
  flex: none;
  width: 18px;
}

@media (hover: hover) {
  .menu-links a:hover {
    background: var(--surface-hover);
  }
}

.menu-links a:active {
  background: var(--surface-hover);
}

.menu-links a:focus-visible {
  outline-offset: -2px;
}

/* wider screens have the links in the bar: a menu left open closes */
@media (min-width: 40.0625rem) {
  .menu {
    display: none;
  }
}

/* phones: the name on the left, the theme switch and the menu on the right */
@media (max-width: 40rem) {
  .bar {
    gap: 0.375rem;
  }

  .tools {
    gap: 0;
  }

  .tools > a {
    display: none;
  }

  .menu-button {
    display: inline-grid;
  }
}
</style>
